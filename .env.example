# Copy to .env.development and/or .env.production with PUBLIC, non-sensitive
# values. Real secrets go in .env.development.local / .env.production.local
# (gitignored) - NEVER commit them. NODE_ENV is managed by next / cross-env.
#
# Generate a real AUTH_SECRET with: openssl rand -base64 32

# Public base URL of the app (used for redirects/metadata)
NEXT_PUBLIC_VERCEL_URL=http://localhost:3000

# PostgreSQL connection string.
# Local Docker DB (see docker-compose.yml defaults):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/timesheet-tracker
# Remote (Neon) example:
# DATABASE_URL=postgresql://user:pass@host.neon.tech/timesheet-tracker?sslmode=require

# Secret used by Auth.js to sign session JWTs
AUTH_SECRET=your-secret-key

# --- Docker Compose only (used by `pnpm db:up`) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=timesheet-tracker

# --- Optional seed overrides (see README "Demo Credentials") ---
# SEED_DEMO_EMAIL=demo@timesheet.dev
# SEED_DEMO_PASSWORD=Demo#Pass1
# SEED_DEMO_ORG_SLUG=acme-analytics
# SEED_EXTRA_ORGS=false